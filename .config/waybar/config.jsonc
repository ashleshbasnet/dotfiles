{
    "layer": "top",
    "position": "top",
    "height": 32, 
    "margin-top": 10,
    "margin-bottom": 0,
    "margin-left": 20,
    "margin-right": 20,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "battery"],

    // Workspace Configuration
    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5] // Keeps a constant 5 workspaces visible for symmetrical styling
        }
    },

    // Audio
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon}  {volume}%",
        "format-muted": "   Muted",
        "format-icons": {
          "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    // Networking
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "   Wired",
        "format-disconnected": "   Disconnected",

        "format-alt": " ",
        "format-alt-click": "click-right",

        "on-click": "kitty --class floating_tui -e nmtui",
        "format-disconnected": "Disconnected",

        "tooltip-format-wifi": "Signal Strength: {signalStrength}%"

    },

    "clock": {
        "format": "{:%H:%M}", // 24 hr format
        "format-alt": "{:%I:%M %p}", // 12 hr format
        "tooltip-format": "<tt><small>{calendar}</small></tt>",

        "calendar": {
          "mode"          : "month",
          "on-scroll"     : 1,
          "format": {
            "months":     "<span color='#e8eaed'><b>{}</b></span>",
            "weekdays":   "<span color='#6cbdde'><b>{}</b></span>",
            "days":       "<span color='#a1a8b3'>{}</span>",
            
            "today":      "<span color='#ff6c6b'><b><u>{}</u></b></span>"
          }
        },
    
        // Scrolling between months
        "actions": {
          "on-scroll-up": "shift_up",
          "on-scroll-down": "shift_down"
        }
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
       
        "format": "{icon}  {capacity}%",

        // UNPLUGGED STATE 
        "format-discharging": "{icon}  {capacity}%",

        // PLUGGED IN AND CHARGING
        "format-charging": "   {icon}  {capacity}%",

        // PLUGGED IN BUT COMPLETELY FULL 
        "format-plugged": " {capacity}%",
        "format-not-charging": " {capacity}%",

        "format-alt": "{icon}  {time}",
        "format-icons": ["", "", "", "", ""],

        // LEFT-CLICK: Opens system resource monitor
        "on-click": "kitty --class floating_tui -e btop",
        // Am not completely sure about this section


        "tooltip-format": "{timeTo} - Health: {health}%"
    }
}
